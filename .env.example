# Copie para .env apenas no seu computador; o servidor lê variáveis de processo.
# Para carregar: set -a; source .env; set +a
APP_MODE=demo
APP_HOST=127.0.0.1
APP_PORT=8000
# Usado pelo Docker Compose com Caddy: seu subdomínio gratuito no DuckDNS.
APP_DOMAIN=
APP_TIMEZONE=America/Sao_Paulo
DATA_DIR=.data

# Obrigatórios para APP_MODE=live. Insira os valores nas configurações seguras.
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
PUBLIC_BASE_URL=
APP_PASSWORD=
META_API_VERSION=v25.0

# Opcional: sem chave, usa modelos locais de texto e artes JPEG.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
