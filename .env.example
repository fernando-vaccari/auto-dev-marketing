# Copie para .env apenas no seu computador; o servidor lê variáveis de processo.
# Para carregar: set -a; source .env; set +a
APP_MODE=demo
APP_HOST=127.0.0.1
APP_PORT=8000
# Usado pelo Docker Compose com Caddy: seu subdomínio gratuito no DuckDNS.
APP_DOMAIN=
APP_TIMEZONE=America/Sao_Paulo
DATA_DIR=.data

# Obrigatórios para APP_MODE=live. Insira os valores nas configurações seguras.
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
PUBLIC_BASE_URL=
# APP_PASSWORD também é obrigatória para o Estúdio local; preserve sua senha existente.
APP_PASSWORD=
META_API_VERSION=v25.0

# Opcional: sem chave, usa modelos locais de texto e artes JPEG.
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Estúdio de Reels — limites locais (MiB), sem publicação.
REELS_UPLOAD_MB=512
REELS_MUSIC_MB=64
REELS_STORAGE_MB=8192
REELS_MIN_FREE_MB=1024
REELS_THREADS=4
REELS_QUEUE_LIMIT=3
REELS_TIMEOUT_SECONDS=900
REELS_FILE_LIMIT_MB=512
# Se usar Caddy, mantenha este limite acima de REELS_UPLOAD_MB/REELS_MUSIC_MB.
REELS_PROXY_UPLOAD_LIMIT=513MB
# Opcional: modelo Piper pt-BR já instalado localmente, nunca recebido pelo navegador.
REELS_PIPER_MODEL=
